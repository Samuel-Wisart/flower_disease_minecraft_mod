{
  "multipart": [
    {
      "when": { "facing": "up" },
      "apply": { "model": "flowerdisease:block/diseased_red_tulip" }
    },
    {
      "when": { "facing": "north" },
      "apply": { "model": "flowerdisease:block/diseased_red_tulip_tilted", "y": 0 }
    },
    {
      "when": { "facing": "east" },
      "apply": { "model": "flowerdisease:block/diseased_red_tulip_tilted", "y": 90 }
    },
    {
      "when": { "facing": "south" },
      "apply": { "model": "flowerdisease:block/diseased_red_tulip_tilted", "y": 180 }
    },
    {
      "when": { "facing": "west" },
      "apply": { "model": "flowerdisease:block/diseased_red_tulip_tilted", "y": 270 }
    }
  ]
}
